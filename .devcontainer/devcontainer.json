{
	"image": "mcr.microsoft.com/devcontainers/java:1-17-bullseye",
	"features": {
		"ghcr.io/devcontainers/features/java:1": {
			"version": "17"
		}
	},
	"hostRequirements": {
		"cpus": 2
	},
	"waitFor": "onCreateCommand",
	"customizations": {
		"vscode": {
			"extensions": [
				"vscjava.vscode-java-debug",
				"vscjava.vscode-java-pack",
				"ms-azuretools.vscode-docker"
			]
		}
	}
}